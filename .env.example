# Optional runtime settings for applications embedding the swarm.
# Keep credentials in the host environment or a secret manager.

SWARM_LOG_LEVEL=INFO
SWARM_MAX_TASK_RETRIES=5
SWARM_MAX_DESCRIPTION_CHARS=20000
SWARM_MAX_PAYLOAD_BYTES=1000000
SWARM_MAX_WORKFLOW_STEPS=100
SWARM_MAX_CONCURRENT_WORKERS=32
